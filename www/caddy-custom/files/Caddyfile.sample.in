# Drop-in configuration: files %%ETCDIR%%/Caddyfile.d/*.caddyfile are read
# here. A global options block ({ ... }) must come first: put your own above
# this line or in Caddyfile.d/00-global.caddyfile (only one such block may
# exist). Examples for the bundled modules: %%EXAMPLESDIR%%/README
import %%ETCDIR%%/Caddyfile.d/*.caddyfile

# The Caddyfile is an easy way to configure your Caddy web server.
#
# Unless the file starts with a global options block, the first
# uncommented line is always the address of your site.
#
# The demo site is plain HTTP on port 80. A site named "localhost" or
# "*.local", or one using "tls internal", is served from Caddy's own CA, and
# Caddy then tries to install that CA's root certificate into the system trust
# store with sudo on every start, which hangs or fails for an unprivileged
# caddy_user. If you use the internal CA, either trust its root certificate
# once, as root:
#
#	mkdir -p /usr/local/share/certs
#	cp /var/db/caddy/data/caddy/pki/authorities/local/root.crt \
#	   /usr/local/share/certs/Caddy_Local_Authority_root.pem
#	chmod 0644 /usr/local/share/certs/Caddy_Local_Authority_root.pem
#	certctl rehash
#
# (not /usr/local/etc/ssl/certs, certctl does not index it), or add this
# global options block at the very top of the Caddyfile:
#
#	{
#		skip_install_trust
#	}
#
# Replace ":80" with your domain name to get automatic HTTPS from ACME.
:80 {
	# Set this path to your site's directory:
	root * %%WWWDIR%%

	# Enable the static file server:
	file_server

	# Set up a reverse proxy:
	# reverse_proxy localhost:8080

	# Enable logging:
	log {
		output file /var/log/caddy/access.log
		format json
	}
}

# Refer to the Caddy docs for more information:
# https://caddyserver.com/docs/caddyfile
